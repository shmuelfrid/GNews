# Copy to .env and fill from Firebase console > Project settings > Your apps > Web app config.
# Leave EXPO_PUBLIC_FIREBASE_API_KEY empty to run in local demo mode (AsyncStorage only, AI disabled).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Optional: point callable functions at the local emulator, e.g. 192.168.1.20:5001
EXPO_PUBLIC_FUNCTIONS_EMULATOR=
