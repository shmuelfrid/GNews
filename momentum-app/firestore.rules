rules_version = '2';

// Momentum – each user can only touch their own tree.
// users/{uid}                 profile doc
// users/{uid}/days/{date}     one doc per local day (YYYY-MM-DD)
// users/{uid}/meta/ai         AI rate-limit counter (server-only writes)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function optNum(d, k) { return !(k in d) || d[k] == null || d[k] is number; }
    function optStr(d, k, max) { return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= max); }
    function optList(d, k, max) { return !(k in d) || (d[k] is list && d[k].size() <= max); }
    function optMap(d, k) { return !(k in d) || d[k] is map; }
    function optMapOrNull(d, k) { return !(k in d) || d[k] == null || d[k] is map; }

    function validProfile(d) {
      return d.keys().size() <= 60
        && optStr(d, 'name', 80)
        && optStr(d, 'sex', 16)
        && optStr(d, 'unit', 4)
        && optStr(d, 'theme', 10)
        && optStr(d, 'startDate', 10)
        && optStr(d, 'targetDate', 10)
        && optNum(d, 'birthYear')
        && optNum(d, 'heightCm')
        && optNum(d, 'startKg')
        && optNum(d, 'goalKg')
        && optNum(d, 'paceKgPerWeek')
        && optNum(d, 'stepGoal')
        && optNum(d, 'waistCm')
        && optList(d, 'celebrated', 200)
        && (optStr(d, 'activityBaseline', 16) || optMap(d, 'activityBaseline'));
    }

    function validDay(date, d) {
      return d.keys().size() <= 30
        && (!('date' in d) || d.date == date)
        && optList(d, 'weights', 50)
        && optList(d, 'foods', 200)
        && optList(d, 'workouts', 50)
        && optMapOrNull(d, 'activity')
        && optMap(d, 'planTicks');
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile(request.resource.data);

      match /days/{date} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && validDay(date, request.resource.data);
      }

      // Server-managed (Admin SDK bypasses rules). Owner may read their quota.
      match /meta/{doc} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Any other owner subcollections (future use) – owner only.
      match /{coll}/{docId=**} {
        allow read, write: if isOwner(uid) && coll != 'meta' && coll != 'days';
      }
    }
  }
}
