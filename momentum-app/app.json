{
  "expo": {
    "name": "Momentum",
    "slug": "momentum",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "momentum",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F6F7F9",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.momentum.tracker",
      "infoPlist": {
        "NSCameraUsageDescription": "Momentum uses the camera to photograph meals and workout screens so Claude can estimate calories.",
        "NSPhotoLibraryUsageDescription": "Momentum reads photos you choose (meals, workout and Samsung Health screenshots) to estimate calories."
      }
    },
    "android": {
      "package": "com.momentum.tracker",
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_WEIGHT"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F6F7F9",
          "dark": { "image": "./assets/images/splash-icon.png", "backgroundColor": "#0E1018" }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Momentum reads photos you choose (meals, workout and Samsung Health screenshots) to estimate calories.",
          "cameraPermission": "Momentum uses the camera to photograph meals and workout screens so Claude can estimate calories."
        }
      ],
      "expo-document-picker",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": { "minSdkVersion": 26, "compileSdkVersion": 36, "targetSdkVersion": 36 }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
